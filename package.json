{
  "name": "assemble-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "assembleagents.dev: dashboard, agent check-in, and the referee's clock. Observational only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "check:js": "node --check public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply assemble --local",
    "db:migrate": "wrangler d1 migrations apply assemble --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
